# API Base URL
#
# The root URL used by the frontend to reach the backend API.
# This value is injected at build time by Vite (see: https://vite.dev/guide/env-and-mode).
#
# - Development: point to your locally running Spring Boot instance (default: http://localhost:8080)
# - Production: point to the deployed backend URL
#
# Copy this file to .env.development / .env.production and adjust accordingly.
VITE_API_BASE_URL=http://localhost:8080