# Base URL for the OpenAI-compatible API endpoint.
OPENAI_BASE_URL=

# API key used to authenticate requests to the OpenAI-compatible provider.
# Never commit a key to version control.
OPENAI_API_KEY=

# Absolute path to the Tesseract "tessdata" directory containing language data files.
# These can be downloaded from: https://github.com/tesseract-ocr/tessdata
TESSERACT_DATAPATH=